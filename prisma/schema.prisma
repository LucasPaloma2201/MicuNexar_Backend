generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model auth {
  id            Int      @id @default(autoincrement())
  user_id       Int      @unique
  password_hash String   @db.VarChar(255)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
  users         users    @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_auth_users")
}

model categories {
  id          Int        @id @default(autoincrement())
  name        String     @unique @db.VarChar(100)
  description String?    @db.VarChar(255)
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  services    services[]
  ventures    ventures[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model locations {
  id              Int         @id @default(autoincrement())
  name            String      @unique(map: "uq_locations_province_name", where: raw("(parent_id IS NULL)")) @db.VarChar(120)
  parent_id       Int?
  locations       locations?  @relation("locationsTolocations", fields: [parent_id], references: [id], onDelete: Restrict, map: "fk_locations_parent")
  other_locations locations[] @relation("locationsTolocations")
  requests        requests[]
  services        services[]
  ventures        ventures[]

  @@unique([parent_id, name], map: "uq_locations_parent_name")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model nexers {
  id                  Int        @id @default(autoincrement())
  user_id             Int        @unique
  public_name         String     @db.VarChar(120)
  description         String?
  verification_status String     @default("PENDING") @db.VarChar(16)
  created_at          DateTime   @default(now()) @db.Timestamptz(6)
  users               users      @relation(fields: [user_id], references: [id], map: "fk_nexers_users")
  services            services[]
  ventures            ventures[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model requests {
  id           Int       @id @default(autoincrement())
  user_id      Int
  service_id   Int?
  venture_id   Int?
  location_id  Int
  title        String    @db.VarChar(150)
  description  String
  status       String    @default("PENDING") @db.VarChar(25)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  completed_at DateTime? @db.Timestamptz(6)
  locations    locations @relation(fields: [location_id], references: [id], map: "fk_requests_locations")
  services     services? @relation(fields: [service_id], references: [id], onDelete: Restrict, map: "fk_requests_services")
  users        users     @relation(fields: [user_id], references: [id], map: "fk_requests_users")
  ventures     ventures? @relation(fields: [venture_id], references: [id], onDelete: Restrict, map: "fk_requests_ventures")
}

model services {
  id          Int        @id @default(autoincrement())
  nexer_id    Int
  category_id Int
  location_id Int
  title       String     @db.VarChar(150)
  description String?
  is_active   Boolean    @default(false)
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  requests    requests[]
  categories  categories @relation(fields: [category_id], references: [id], map: "fk_services_categories")
  locations   locations  @relation(fields: [location_id], references: [id], map: "fk_services_locations")
  nexers      nexers     @relation(fields: [nexer_id], references: [id], map: "fk_services_nexers")
}

model users {
  id         Int        @id @default(autoincrement())
  full_name  String     @db.VarChar(120)
  email      String     @unique @db.VarChar(180)
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  updated_at DateTime   @default(now()) @db.Timestamptz(6)
  auth       auth?
  nexers     nexers?
  requests   requests[]
}

model ventures {
  id          Int        @id @default(autoincrement())
  nexer_id    Int
  category_id Int
  location_id Int
  name        String     @db.VarChar(150)
  description String?
  is_active   Boolean    @default(false)
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  requests    requests[]
  categories  categories @relation(fields: [category_id], references: [id], map: "fk_ventures_categories")
  locations   locations  @relation(fields: [location_id], references: [id], map: "fk_ventures_locations")
  nexers      nexers     @relation(fields: [nexer_id], references: [id], map: "fk_ventures_nexers")
}
